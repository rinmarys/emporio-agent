# Copy to .env and fill in your keys. Never commit .env.

# Which LLM provider the agent uses: gemini (default) or groq
LLM_PROVIDER=gemini

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_API_KEY=

# Groq (fallback when Gemini hits rate limits): https://console.groq.com/keys
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
