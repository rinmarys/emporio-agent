# Copy to .env and fill in your key. Never commit .env.

# Groq (free key): https://console.groq.com/keys
GROQ_API_KEY=

# Main model, then fallbacks tried in order when a model fails (e.g. daily quota, 429).
# Each Groq model has its own free daily quota, so the chain keeps the agent answering.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b
