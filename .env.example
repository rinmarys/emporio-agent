# Copy to .env and fill in your keys. Never commit .env.

# Which LLM provider the agent uses: groq (default) or gemini
LLM_PROVIDER=groq

# Groq: https://console.groq.com/keys
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# Google AI Studio (alternative; free tier is ~5 requests/min): https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_API_KEY=
